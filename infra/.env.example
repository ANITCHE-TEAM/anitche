# Copier ce fichier en "infra/.env" sur le serveur de prod (jamais commité).
# Utilisé par : docker compose -f infra/docker-compose.prod.yml --env-file infra/.env up -d

SECRET_KEY=change-me-in-production
# Clés de chiffrement des données KYC (numéro mobile money), séparées
# par des virgules, la clé ACTIVE en premier (rotation : voir
# docs/MODULE_UTILISATEURS.md, « Gestion de la clé »). Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# À conserver dans un gestionnaire de secrets, JAMAIS avec la base ni ses
# sauvegardes : clé perdue = données illisibles pour toujours.
FIELD_ENCRYPTION_KEYS=
# backend-django : nom du service Docker, utilisé par FastAPI pour ses
# appels internes à Django (vérification du jeton). Sans lui, Django
# répond 400 (DisallowedHost) à FastAPI.
ALLOWED_HOSTS=anitche.com,www.anitche.com,backend-django
CORS_ALLOWED_ORIGINS=https://anitche.com
# Base des liens vers le frontend (URL encodée dans les QR des passeports).
# Domaine définitif en attente de confirmation (docs/MODULE_PASSEPORT_QR.md).
FRONTEND_BASE_URL=https://anitche.com

# F-18 : adresse utilisée par Let's Encrypt pour les alertes (expiration du
# certificat, révocation) — voir infra/scripts/init-lets-encrypt.sh.
CERTBOT_EMAIL=admin@anitche.com

DB_NAME=anitche
DB_USER=anitche_prod
DB_PASSWORD=postgres
# Mot de passe du rôle PostgreSQL en lecture seule du service FastAPI
# (distinct de DB_USER). Aléatoire et long ; même règle que les autres
# secrets : gestionnaire de secrets, jamais dans le dépôt.
FASTAPI_DB_PASSWORD=

# Paiements (docs/MODULE_PAIEMENTS.md, « Gestion des clés CinetPay »).
# Identifiants du compte marchand CinetPay Côte d'Ivoire (clé sk_live_ en
# production). Comme FIELD_ENCRYPTION_KEYS : gestionnaire de secrets,
# jamais dans le dépôt.
PAIEMENT_FOURNISSEUR=cinetpay
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
# Adresse publique HTTPS de l'API (URL de notification des paiements).
BACKEND_BASE_URL=https://api.anitche.com
