# Copier ce fichier en "infra/.env" sur le serveur de prod (jamais commité).
# Utilisé par : docker compose -f infra/docker-compose.prod.yml --env-file infra/.env up -d

SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=anitche.com,www.anitche.com
CORS_ALLOWED_ORIGINS=https://anitche.com

# F-18 : adresse utilisée par Let's Encrypt pour les alertes (expiration du
# certificat, révocation) — voir infra/scripts/init-lets-encrypt.sh.
CERTBOT_EMAIL=admin@anitche.com

DB_NAME=anitche
DB_USER=anitche_prod
DB_PASSWORD=postgres
