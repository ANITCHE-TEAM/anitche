# Copier ce fichier en "infra/.env" sur le serveur de prod (jamais commité).
# Utilisé par : docker compose -f infra/docker-compose.prod.yml --env-file infra/.env up -d

SECRET_KEY=change-me-in-production
# Clés de chiffrement des données KYC (numéro mobile money), séparées
# par des virgules, la clé ACTIVE en premier (rotation : voir
# docs/MODULE_UTILISATEURS.md, « Gestion de la clé »). Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# À conserver dans un gestionnaire de secrets, JAMAIS avec la base ni ses
# sauvegardes : clé perdue = données illisibles pour toujours.
FIELD_ENCRYPTION_KEYS=
# backend-django : nom du service Docker, utilisé par FastAPI pour ses
# appels internes à Django (vérification du jeton). Sans lui, Django
# répond 400 (DisallowedHost) à FastAPI.
ALLOWED_HOSTS=anitche.com,www.anitche.com,backend-django
CORS_ALLOWED_ORIGINS=https://anitche.com
# Base des liens vers le frontend (URL encodée dans les QR des passeports).
# Domaine définitif en attente de confirmation (docs/MODULE_PASSEPORT_QR.md).
FRONTEND_BASE_URL=https://anitche.com

# Adresse utilisée par Let's Encrypt pour les alertes (expiration du
# certificat, révocation) — voir infra/scripts/init-lets-encrypt.sh.
CERTBOT_EMAIL=admin@anitche.com

DB_NAME=anitche
DB_USER=anitche_prod
# Aléatoire, 12 caractères au moins (check_prod_env.sh refuse « postgres »).
DB_PASSWORD=
# Mot de passe du rôle PostgreSQL en lecture seule du service FastAPI
# (distinct de DB_USER). Aléatoire, 12 caractères au moins, lettres et
# chiffres uniquement (inséré tel quel dans l'URL de connexion de FastAPI) ;
# gestionnaire de secrets, jamais dans le dépôt.
FASTAPI_DB_PASSWORD=
# Recherche FastAPI (docs/MODULE_RECHERCHE.md), obligatoires, en https://.
# Adresse publique de FastAPI derrière nginx, préfixe /fast compris (liens
# next/previous des résultats).
PUBLIC_BASE_URL=https://anitche.com/fast
# Adresse publique des fichiers média de Django (images des produits).
# Nginx sert les médias publics sous /media/ (catalogue/produits,
# catalogue/categories, boutiques/logos, boutiques/bannieres ;
# infra/nginx/nginx.conf), le reste de /media/ répond 404.
MEDIA_BASE_URL=https://anitche.com/media/

# Paiements (docs/MODULE_PAIEMENTS.md, « Gestion des clés CinetPay »).
# Identifiants du compte marchand CinetPay Côte d'Ivoire (clé sk_live_ en
# production). Comme FIELD_ENCRYPTION_KEYS : gestionnaire de secrets,
# jamais dans le dépôt.
PAIEMENT_FOURNISSEUR=cinetpay
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
# Adresse publique HTTPS de Django, ORIGINE SEULE (sans chemin ni « / »
# final) : le code y ajoute /api/paiements/webhook/cinetpay/ (et
# .../transfert/) pour les URL de notification CinetPay, que nginx transmet
# à Django (infra/nginx/nginx.conf). Même domaine que le site : un seul
# certificat, et son hôte figure déjà dans ALLOWED_HOSTS ci-dessus, ce que
# prod.py vérifie au démarrage.
BACKEND_BASE_URL=https://anitche.com

# Emails (codes OTP, notifications) : serveur SMTP du fournisseur d'emails.
# prod.py refuse de démarrer avec un autre backend que SMTP, un serveur ou
# des identifiants vides, TLS et SSL ensemble ou ni l'un ni l'autre
# (identifiants envoyés en clair), ou un expéditeur hors
# @anitche.com. Identifiant et clé SMTP du compte (pas une clé d'API) :
# gestionnaire de secrets, jamais dans le dépôt ; entre apostrophes s'ils
# contiennent des caractères spéciaux (ce fichier est lu par bash et par
# docker compose).
# DNS de anitche.com avant le premier envoi : SPF (autorise le fournisseur),
# DKIM (clé publique donnée par le fournisseur) et DMARC (_dmarc.anitche.com).
# Sans eux, les codes OTP arrivent en spam ou sont refusés.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
# Port 587 avec STARTTLS (EMAIL_USE_TLS=True), ou 465 avec TLS implicite
# (EMAIL_USE_SSL=True et EMAIL_USE_TLS=False) ; toujours l'un des deux,
# jamais les deux.
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Délai maximal d'une opération SMTP, en secondes (1 à 60).
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Entre guillemets : la valeur contient une espace et des chevrons.
DEFAULT_FROM_EMAIL="ANITCHE <no-reply@anitche.com>"

# Sauvegardes chiffrées de la base et des médias (docs/SAUVEGARDES.md),
# chaque nuit à 3 h UTC (infra/scripts/backup.sh), dans un dépôt restic sur
# un stockage compatible S3 hors de ce serveur (Cloudflare R2, Backblaze B2,
# Wasabi…). Transmises au seul conteneur « backup ».
# Dépôt : s3:https://<endpoint>/<bucket>, jamais un chemin local, ex.
#   s3:https://<compte>.r2.cloudflarestorage.com/anitche-sauvegardes
BACKUP_REPOSITORY=
# Mot de passe du dépôt (il chiffre toutes les sauvegardes), 32 caractères
# au moins : openssl rand -base64 32
# Perdu = toutes les sauvegardes illisibles. Gestionnaire de secrets, plus
# une copie hors ligne détenue par le chef de projet ; jamais dans le
# bucket, ni chez le fournisseur de stockage, ni dans le dépôt Git.
BACKUP_PASSWORD=
# Clé d'accès S3 limitée à ce seul bucket.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Facultatif : région du fournisseur (« auto » pour R2) ; vide si aucune.
BACKUP_S3_REGION=
# Facultatif, recommandé : adresse https:// de surveillance « heartbeat »
# (healthchecks.io, Uptime Kuma, Better Stack…), appelée après chaque
# sauvegarde réussie (période 24 h, tolérance 2 h).
BACKUP_PING_URL=
