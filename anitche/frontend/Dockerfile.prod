# Étape 1 : build du bundle React statique
FROM node:20-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Étape 2 : le résultat (dossier dist/) est copié dans une image nginx minimale.
# C'est ce nginx-là qui sert aussi de reverse proxy vers Django et FastAPI
# (voir infra/nginx/nginx.conf, monté dans le conteneur "nginx" de docker-compose.prod.yml).
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
