{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "tasks": {
    "lint": {},
    "typecheck": {},
    "test": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "generer:api": {
      "cache": false
    },
    "verifier:api": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
