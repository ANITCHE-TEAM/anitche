# Image de production d'UN portail : le même Dockerfile construit les quatre,
# choisis par PORTAIL (client, vendeur, livreur ou admin) :
#   docker build -f Dockerfile.prod --build-arg PORTAIL=vendeur .
# Le nginx de l'image ne sert que les fichiers du portail (frontend/nginx/) ;
# nginx, devant, route le sous-domaine vers lui (infra/nginx/nginx.conf).

# Étape 1 : build du bundle du portail.
FROM node:22-alpine AS build

WORKDIR /app

# Version de pnpm : champ packageManager de package.json (engines : node >= 22.13).
RUN corepack enable

# Les dépendances ne dépendent que du lockfile : cette couche et celle de
# l'installation sont communes aux quatre portails (PORTAIL n'est déclaré
# qu'après), donc construites une seule fois.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

COPY turbo.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --offline --frozen-lockfile

# Le portail et ses paquets de workspace (« ... »), rien d'autre.
ARG PORTAIL
RUN case "$PORTAIL" in client|vendeur|livreur|admin) ;; \
      *) echo "PORTAIL doit valoir client, vendeur, livreur ou admin (reçu : '$PORTAIL')." >&2; exit 1 ;; \
    esac \
    && pnpm --filter "@anitche/app-${PORTAIL}..." build

# Étape 2 : nginx sans root (uid 101, port 8080) et le dossier dist/ du portail.
FROM nginxinc/nginx-unprivileged:1.31-alpine

ARG PORTAIL

COPY nginx/portail.conf /etc/nginx/conf.d/default.conf
COPY nginx/en-tetes.conf /etc/nginx/portail-en-tetes.conf
# X-Portail : nom du portail, lu par les contrôles de la CI.
RUN sed -i "s/__PORTAIL__/${PORTAIL}/" /etc/nginx/portail-en-tetes.conf
COPY --from=build /app/apps/${PORTAIL}/dist /usr/share/nginx/html

EXPOSE 8080
